# ==========================================
# HOLYNEX GROUP ENVIRONMENT CONFIGURATION
# ==========================================

# GEMINI_API_KEY: Required for Gemini AI API calls. Server-side only.
# Automatically injected at runtime in Google AI Studio if configured.
GEMINI_API_KEY=""

# APP_URL: The base URL where this applet is hosted (e.g., https://example.com)
APP_URL=""

# DATABASE_URL: PostgreSQL connection string (e.g., postgresql://user:pass@host:5432/dbname)
# If left empty, the application uses durable in-memory/file storage with initial seed data.
DATABASE_URL=""

# ADMIN_PASSWORD: Secure secret passphrase for the protected admin portal.
# Production must provide a strong password. Default fallback in dev: HolynexAdmin2026!
ADMIN_PASSWORD=""

# ADMIN_SECRET_PATH: Custom secret route for the admin portal (default: /admin-portal)
ADMIN_SECRET_PATH="/admin-portal"

# SMS Gateway Integration (e.g., Greenweb, Teletalk, Twilio, BulkSMS BD)
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID="HOLYNEX"

# Cloud Object Storage (S3 / Cloudinary / Vercel Blob)
STORAGE_TOKEN=""
STORAGE_URL=""

# Web Push Notification VAPID Keys (for background dealer notification alerts)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@holynexgroup.com"

